/* Minimal placeholder for Figma-inspired styling. */

QMainWindow {
    background: #f5f3ff;
}

QGroupBox {
    font-weight: 600;
    border: 1px solid #dcd7f5;
    border-radius: 8px;
    margin-top: 12px;
    padding: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}

QPushButton {
    padding: 6px 12px;
}

QTableWidget {
    background: #ffffff;
    gridline-color: #e6e1f5;
}

QHeaderView::section {
    background: #f0ecff;
    padding: 6px;
    border: none;
}
