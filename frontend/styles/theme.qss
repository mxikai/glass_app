/* ========== GLASS App Theme (Glassmorphism Edition) ========== */

/* --- App Background (Subtle Apple-style Gradient) --- */
QMainWindow, QWidget#centralWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #EEF0F8,
                                stop:0.35 #EAE5F4,
                                stop:0.7 #F6E6ED,
                                stop:1 #E6EFEA);
}

/* --- Sidebar --- */
QWidget#sidebar {
    background-color: rgba(108, 92, 231, 0.65);
    border-top: 1.5px solid rgba(255, 255, 255, 0.5);
    border-left: 1.5px solid rgba(255, 255, 255, 0.3);
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px; 
    min-width: 70px;
    max-width: 70px;
}

QPushButton#navBtn {
    background-color: transparent;
    border: none;
    outline: none;
    color: rgba(255, 255, 255, 0.6);
    font-size: 22px;
    padding: 0px;
    margin: 4px -2px 4px 12px; 
    border-top-left-radius: 20px;
    border-bottom-left-radius: 20px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}

QPushButton#navBtn:hover {
    background-color: rgba(255, 255, 255, 0.2);
    color: white;
}

QPushButton#navBtn:checked {
    background-color: transparent;
    color: #6C5CE7;            
}

/* --- Main Content Area --- */
QWidget#contentArea {
    background-color: transparent; /* Lets the gradient show through! */
}

QLabel#pageSubtitle { color: #8A8A9E; font-size: 12px; font-family: 'Segoe UI'; }
QLabel#pageTitle { color: #1A1A3E; font-size: 24px; font-weight: 700; font-family: 'Segoe UI'; }

/* =========================================
   THE GLASS CARDS 
   ========================================= */
QWidget#statCard, QFrame#profilePanel, QWidget#bucketCard {
    background-color: rgba(255, 255, 255, 0.55); /* Frosted White Glass */
    border-top: 1.5px solid rgba(255, 255, 255, 0.9); /* Top light reflection */
    border-left: 1.5px solid rgba(255, 255, 255, 0.7);
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    border-right: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 22px;
}

/* The Purple Overview Card */
QFrame#purpleOverviewCard {
    background-color: rgba(108, 92, 231, 0.65);
    border-top: 2.5px solid rgba(255, 255, 255, 0.6);
    border-left: 2.5px solid rgba(255, 255, 255, 0.4);
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
    border-right: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 22px;
}

/* The Table Background */
QTableWidget#modernTable {
    background-color: rgba(255, 255, 255, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 16px;
    padding: 10px;
}
QTableWidget#modernTable::item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.6);
    padding: 4px;
    color: #1A1A3E;
}
QTableWidget#modernTable::item:selected {
    background-color: #d6d3fd; 
    color: #6C5CE7;
    border-radius: 6px;
}
QHeaderView::section {
    background-color: transparent;
    border: none;
    font-weight: 700;
    color: #8A8A9E;
    border-bottom: 2px solid rgba(255, 255, 255, 0.8);
    padding-bottom: 8px;
    text-align: left;
}

/* --- Form Inputs (Frosted Indent) --- */
QLineEdit#formInput, QComboBox#formInput, QDoubleSpinBox#formInput, QSpinBox#formInput {
    background-color: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #1A1A3E;
}
QLineEdit#formInput:focus, QComboBox#formInput:focus, QDoubleSpinBox#formInput:focus, QSpinBox#formInput:focus {
    border: 1.5px solid #6C5CE7;
    background-color: rgba(255, 255, 255, 0.8);
}

/* --- Search Bar --- */
QLineEdit#searchBar {
    background-color: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 13px;
    font-family: 'Segoe UI';
    color: #1A1A3E;
}
QLineEdit#searchBar:focus {
    border: 1.5px solid #6C5CE7;
    background-color: rgba(255, 255, 255, 0.8);
}

/* --- Buttons --- */
QPushButton#primaryBtn {
    background-color: #6C5CE7;
    color: white;
    border-radius: 12px;
    border: none;
    font-size: 13px;
    font-weight: 600;
    font-family: 'Segoe UI';
    padding: 10px 20px;
}
QPushButton#primaryBtn:hover { background-color: #5A4BD1; }

QPushButton#secondaryBtn {
    background-color: rgba(255, 255, 255, 0.6);
    color: #8A8A9E;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 12px;
    font-weight: 600;
    padding: 10px;
}
QPushButton#secondaryBtn:hover {
    background-color: rgba(255, 255, 255, 0.9);
    color: #1A1A3E;
}

QPushButton#dangerBtn {
    background-color: rgba(253, 121, 168, 0.15);
    color: #FD79A8;
    border: 1px solid rgba(253, 121, 168, 0.3);
    border-radius: 12px;
    font-weight: 600;
    padding: 10px;
}
QPushButton#dangerBtn:hover {
    background-color: #FD79A8;
    color: white;
}

/* --- Badges --- */
QLabel#badgePaid, QLabel#badgeApproved {
    background-color: rgba(108, 92, 231, 0.15);
    color: #6C5CE7;
    border-radius: 8px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#badgePending {
    background-color: rgba(253, 121, 168, 0.15);
    color: #FD79A8;
    border-radius: 8px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

/* --- Progress Bars --- */
QProgressBar#bucketProgress, QProgressBar {
    background-color: rgba(255, 255, 255, 0.5);
    border-radius: 4px;
    border: none;
    height: 7px;
    text-align: right;
}
QProgressBar::chunk { border-radius: 4px; background-color: #6C5CE7; }
QProgressBar#bucketProgressPink::chunk { border-radius: 4px; background-color: #FD79A8; }
QProgressBar#bucketProgressGreen::chunk { border-radius: 4px; background-color: #00B894; }

/* --- Scrollbar & Tabs --- */
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    background: rgba(108, 92, 231, 0.3);
    border-radius: 3px;
    min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

QTabWidget#modernTabs::pane { border: none; background: transparent; padding-top: 10px; }
QTabBar::tab {
    background: transparent;
    color: #8A8A9E;
    font-family: 'Segoe UI';
    font-size: 14px;
    font-weight: 600;
    padding: 8px 24px;
    border-bottom: 2px solid transparent;
    margin-right: 12px;
}
QTabBar::tab:hover { color: #6C5CE7; }
QTabBar::tab:selected {
    color: #6C5CE7;
    border-bottom: 3px solid #6C5CE7;
}

/* --- Dropdown Fix --- */
QComboBox QAbstractItemView {
    background-color: rgba(255, 255, 255, 0.95);
    color: #1A1A3E;
    selection-background-color: rgba(108, 92, 231, 0.15);
    selection-color: #6C5CE7;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 8px;
    outline: none;
    padding: 4px;
}
QComboBox::drop-down { border: none; background: transparent; }